{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "common-badge",
	"title": "Common Badge",
	"type": "registry:component",
	"description": "Étiquette adaptable au thème du projet.",
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from 'svelte';\n  import type { HTMLAttributes } from 'svelte/elements';\n  type Props = HTMLAttributes<HTMLSpanElement> & { variant?: 'primary' | 'secondary' | 'outline'; children?: Snippet };\n  let { variant = 'secondary', class: className = '', children, ...rest }: Props = $props();\n  const variants = { primary: 'bg-primary text-primary-foreground', secondary: 'bg-secondary text-secondary-foreground', outline: 'border border-border text-foreground' };\n</script>\n<span class=\"inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium {variants[variant]} {className}\" {...rest}>{@render children?.()}</span>\n",
			"type": "registry:component",
			"target": "common-badge.svelte"
		}
	]
}