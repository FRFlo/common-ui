{
	"name": "common-ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bun run build:registry && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:registry": "shadcn-svelte registry build",
		"deploy": "bun run build && wrangler deploy",
		"lint": "oxlint --deny-warnings && eslint \"src/**/*.svelte\" --max-warnings 0",
		"lint:fix": "oxlint --fix --deny-warnings && eslint \"src/**/*.svelte\" --fix --max-warnings 0",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@shadcn/lint": "^0.2.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitest/coverage-v8": "^5.1.0",
		"bits-ui": "^2.7.0",
		"cn": "^0.4.0",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.0",
		"jsdom": "^31.0.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0",
		"zod": "^4.4.3"
	}
}
